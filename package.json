{
  "name": "arcanea-dashboard-template",
  "version": "1.0.0",
  "private": true,
  "description": "Analytics dashboard with six reusable widgets, Motion for React, sample data and no required backend.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "tokens:export": "node scripts/export-design-tokens.mjs",
    "marketplace:export": "node scripts/export-marketplace.mjs",
    "release:check": "node scripts/check-release.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:release": "node --test tests/release-package.test.mjs tests/release-exports.test.mjs",
    "test:browser": "playwright test",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "14.14.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0"
}
